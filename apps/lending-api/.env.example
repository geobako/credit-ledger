# lending-api settings for `make dev` (the API running directly on your machine).
# `make dev` copies this to apps/lending-api/.env the first time; edit that copy, not this file.
# Docker (`make up`) does not use it: docker-compose.yml sets the container's variables.
# Every option, with its default, is in src/config/env.ts.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_FORMAT=pretty
DATABASE_URL=postgres://acme:acme@localhost:5433/acme_credit
WEBHOOK_SECRET=local-dev-webhook-secret-change-me-0123456789
SANDBOX_ENABLED=true
GATEWAY_SHARED_SECRET=local-dev-gateway-secret-change-me-0123456789
WEB_ORIGINS=http://localhost:5173
# Optional ES256 PEMs (\n-escaped). Generated per boot when absent outside production.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
