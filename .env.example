# Copy to .env for local overrides. docker compose provides these by default.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_FORMAT=pretty
DATABASE_URL=postgres://acme:acme@localhost:5433/acme_credit
WEBHOOK_SECRET=local-dev-webhook-secret-change-me-0123456789
SANDBOX_ENABLED=true
WEB_ORIGINS=http://localhost:5173
# Optional ES256 PEMs (\n-escaped). Generated per boot when absent outside production.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
